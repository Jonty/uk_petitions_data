{
    "attributes": {
        "action": "Ban MPs who resign with open standards investigations from standing as an MP",
        "additional_details": "",
        "background": "MPs that resign and therefore escape open parliamentary standards investigations should be banned from standing as an MP, unless the investigations are resumed and completed whilst they are not in office.",
