{
    "attributes": {
        "action": "Increase the VAT taxable turnover threshold to \u00a3150,000 for small businesses",
        "additional_details": "In our view, increasing the taxable turnover threshold to \u00a3150,000 would grow business with the chance to explore more avenues of their trade.",
        "background": "We believe small businesses are struggling to grow with the current threshold and many businesses are worse off when registering for VAT as you need to make significantly more than the current \u00a390,000 to see the benefits.",
        "closed_at": null,
