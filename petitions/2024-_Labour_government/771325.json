        "other_parliamentary_business": [
            {
                "body": "On 16 July, Daniel Francis MP will lead a debate in Parliament on Capital funding for Changing Places toilets.\n\nIf you have recently used a Changing Places toilet, whether personally or whilst accompanying someone, please share your experiences and insights with him:\n\nFind out more and answer a survey[1].\n\nYour stories will help inform his debate, and he may quote you directly in Parliament.\n\nDeadline: midday, 15 July.\n\nFrom 16 July, you can:\n\n* Watch the debate\n* Read the transcript\n* See other relevant material\n\nJust use the link above.\n\n[1]: https://ukparliament.shorthandstories.com/cet-changing-places-toilets/index.html",
                "created_at": "2026-07-08T16:20:50.180Z",
                "occurred_on": "2026-07-16",
                "subject": "Share your experience of Changing Places toilets: Parliamentary debate",
                "updated_at": "2026-07-08T16:20:50.180Z"
