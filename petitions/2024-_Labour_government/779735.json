    "attributes": {
        "action": "Remove VAT from sunscreen and sunblock",
        "additional_details": "",
        "background": "Skin cancer is increasing in the UK, with around 3,800 deaths reported annually. We believe sunscreen and sunblock should not be subject to VAT due to being a cosmetic product, and should be fully exempted from VAT.",
