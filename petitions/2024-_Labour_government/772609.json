{
    "attributes": {
        "action": "Reduce salary for MPs who miss over 30% of their votes",
        "additional_details": "MPs are elected to vote on our behalf. We call on Parliament to introduce proportional salary reductions for MPs missing more than 30% of Parliamentary divisions per session, with exemptions for the Speaker, illness, parental leave, and official duties. MPs are paid over \u00a391,000 a year \u2014 we believe taxpayers deserve representatives who show up.",
        "background": "We call on Parliament to introduce financial sanctions in the form of proportional salary reductions for any who participates in fewer than 70% of Parliamentary divisions, with fair exemptions for the Speaker, illness, parental leave, and official duties.",
        "closed_at": null,
