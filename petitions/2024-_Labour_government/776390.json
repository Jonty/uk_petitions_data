{
    "attributes": {
        "action": "Prevent MPs who resign their seat from standing for re-election for 12 months",
        "additional_details": "This would prevent the waste of resources caused by an MP resigning and immediately contesting the same seat again.",
        "background": "If an MP chooses to resign from the UK Parliament during a parliamentary term, they would be ineligible to run for election for any seat, including the one previously held, for a minimum period of 12 months.",
